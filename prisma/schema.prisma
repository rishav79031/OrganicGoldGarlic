datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  city      String?
  product   String
  quantity  String
  message   String?
  status    String   @default("Pending")
  createdAt DateTime @default(now())
}
